{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/prompt_manifest.schema.json",
  "title": "Prompt Manifest",
  "type": "object",
  "required": [
    "id",
    "version",
    "status",
    "endpoint",
    "api_version",
    "system_message",
    "user_template",
    "variables",
    "test_cases"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "type": "string", "enum": ["dev", "staging", "production"] },
    "task": { "type": "string", "minLength": 1 },
    "endpoint": { "type": "string", "minLength": 1 },
    "api_version": { "type": "string", "enum": ["v1", "v2"] },
    "schema_ref": { "type": "string" },
    "system_message": { "type": "string" },
    "user_template": { "type": "string" },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "required": { "type": "boolean" },
          "default": {}
        }
      }
    },
    "fewshot_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "test_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["inputs"],
        "properties": {
          "name": { "type": "string" },
          "inputs": { "type": "object" },
          "assertions": {
            "type": "array",
            "items": { "type": "object" }
          }
        }
      }
    },
    "rollout": { "type": "object" },
    "created_by": { "type": "string" },
    "reviewed_by": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      ]
    },
    "approvals": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 0
    },
    "changelog": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": { "type": "string" },
          "date": { "type": "string" },
          "changes": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false
}
